        {
          "OptionId": "e0c09d6d1f344a9ead2fd3f2cc240a8d",
          "Text": "\u04AE\u0439\u043B\u0434\u0432\u044D\u0440\u0436\u0438\u043B\u0442\u0438\u0439\u0433 \u0434\u044D\u043C\u0436\u0441\u044D\u043D",
          "InvitesOwnWords": false
        },
        {
          "OptionId": "0138a518191c479d987a9a15e9c1f90d",
          "Text": "\u0425\u04E9\u0434\u04E9\u04E9 \u0430\u0436 \u0430\u0445\u0443\u0439\u043D \u0441\u0430\u043B\u0431\u0430\u0440\u044B\u0433 \u0434\u044D\u043C\u0436\u0441\u044D\u043D",
          "InvitesOwnWords": false
        },
        {
          "OptionId": "e3069f05fc7541cebc42e9256ce9d6f0",
          "Text": "\u0410\u044F\u043B\u0430\u043B,\u0436\u0443\u0443\u043B\u0447\u043B\u0430\u043B\u044B\u0433 \u0434\u044D\u043C\u0436\u0441\u044D\u043D",
          "InvitesOwnWords": false
        },
        {
          "OptionId": "efe2717855a547d69e9867ae1fe67c77",
          "Text": "\u0425\u0430\u0440\u0438\u043B\u0446\u0430\u0430,\u0445\u043E\u043B\u0431\u043E\u043E,\u0445\u0443\u0434\u0430\u043B\u0434\u0430\u0430\u043D\u044B \u0441\u0430\u043B\u0431\u0430\u0440\u044B\u0433 \u0434\u044D\u043C\u0436\u0441\u044D\u043D",
          "InvitesOwnWords": false
        },
        {
          "OptionId": "d92000deb0834685b75430bdb5ac183d",
          "Text": "\u0411\u0443\u0441\u0430\u0434",
          "InvitesOwnWords": true
        }
      ]
    },
    {
      "QuestionId": "17ea6c19025c4855a93f5a4c145a82e7",
      "Text": "\u0417\u0443\u0443\u043D\u043C\u043E\u0434 \u0445\u043E\u0442\u044B\u043D \u0442\u04E9\u0432\u0438\u0439\u043D \u043E\u0440\u0447\u0438\u043D, \u043D\u04E9\u0445\u0446\u04E9\u043B\u0438\u0439\u0433 \u0441\u0430\u0439\u0436\u0440\u0443\u0443\u043B\u0430\u0445 \u0447\u0438\u0433\u043B\u044D\u043B\u044D\u044D\u0440 \u044F\u043C\u0430\u0440 \u0431\u04AF\u0442\u044D\u044D\u043D \u0431\u0430\u0439\u0433\u0443\u0443\u043B\u0430\u043B\u0442\u0443\u0443\u0434 \u0445\u0438\u0439\u0445 \u0445\u044D\u0440\u044D\u0433\u0442\u044D\u0439 \u0432\u044D?",
      "Kind": "single",
      "Required": false,
      "Options": [
        {
          "OptionId": "1e5c4a24b0ce4b1c93d7c6fde9cad3ae",
          "Text": "\u0422\u04AF\u04AF\u0445\u044D\u043D \u0431\u0430 \u0441\u043E\u0451\u043B\u044B\u043D \u04E9\u0432 \u0443\u043B\u0430\u043C\u0436\u043B\u0430\u043B\u044B\u0433 \u0448\u0438\u043D\u0433\u044D\u044D\u0441\u044D\u043D",
          "InvitesOwnWords": false
        },
        {
          "OptionId": "ae62bb1b3d2b4024be354753345d6cc9",
          "Text": "\u042D\u043A\u043E, \u043D\u043E\u0433\u043E\u043E\u043D \u0431\u0430\u0440\u0438\u043B\u0433\u0430\u0436\u0438\u043B\u0442\u044B\u043D \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u044B\u0433 \u0431\u0430\u0440\u0438\u043C\u0442\u0430\u043B\u0441\u0430\u043D",
          "InvitesOwnWords": false
        },
        {
          "OptionId": "9541666338f245188708364d256b0a9a",
          "Text": "\u041E\u043D\u043E\u0432\u0447\u0442\u043E\u0439, \u0438\u0445 \u0445\u043E\u0442\u044B\u043D \u0448\u0438\u043D\u044D\u043B\u044D\u0433 \u04E9\u043D\u0433\u04E9 \u0442\u04E9\u0440\u0445 \u0431\u04AF\u0445\u0438\u0439",
          "InvitesOwnWords": false
        },
        {
          "OptionId": "e158810a641e4dc9bc9fba19d1f8ae78",
          "Text": "\u0411\u04AF\u0433\u0434\u0438\u0439\u0433 \u0445\u043E\u0441\u043B\u0443\u0443\u043B\u0441\u0430\u043D \u0437\u043E\u0445\u0438\u043E\u043D \u0431\u0430\u0439\u0433\u0443\u0443\u043B\u0430\u043B\u0442",
          "InvitesOwnWords": false
        }
      ]
    },
    {
      "QuestionId": "1cdba6f7d7014f56aea33225af5da87e",
      "Text": "\u0417\u0443\u0443\u043D\u043C\u043E\u0434 \u0445\u043E\u0442\u044B\u043D \u0442\u04E9\u0432\u0438\u0439\u043D \u0445\u04E9\u0433\u0436\u043B\u0438\u0439\u0433 10 \u0436\u0438\u043B\u0438\u0439\u043D \u0434\u0430\u0440\u0430\u0430 \u044F\u043C\u0430\u0440 \u0431\u0430\u0439\u0445\u044B\u0433 \u0442\u04E9\u0441\u04E9\u04E9\u043B\u0436 \u0431\u0430\u0439\u043D\u0430 \u0432\u044D?",
      "Kind": "text",
      "Required": false,
      "Options": []
    },
    {
      "QuestionId": "9c644381a0a146038f1e165874f26622",
      "Text": "\u0415\u0440\u04E9\u043D\u0445\u0438\u0439 \u0442\u04E9\u043B\u04E9\u0432\u043B\u04E9\u0433\u04E9\u04E9\u043D\u0434 \u0442\u0443\u0441\u0433\u0430\u0445 \u0442\u0430\u043D\u044B \u0441\u0430\u043D\u0430\u043B:",
