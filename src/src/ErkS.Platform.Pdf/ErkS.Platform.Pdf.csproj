<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ErkS.Platform.Core\ErkS.Platform.Core.csproj" />
    <ProjectReference Include="..\ErkS.Platform.Contracts\ErkS.Platform.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ErkS.Platform.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The album's Mongolian technical fonts belong to this repository.
      They used to be copied out of the Platform for AutoCAD working copy
      through a sibling-folder path, which exists only on a machine that
      happens to hold both products side by side: every CI build, which checks
      out this repository alone, failed on the missing files.
    -->
    <Content Include="Fonts\isocpeu_mon_3.ttf"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Fonts\isocpeui_mon_3.ttf"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\ErkS.Studio\Assets\logo-erks-source.png"
                      Link="Assets\logo-erks-source.png"
                      LogicalName="ErkS.Platform.Pdf.Assets.logo-erks-source.png" />
  </ItemGroup>

</Project>
