<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Erk-S delta updates: the ONE client library every product updates with (owner, 2026-10-26:
    «зөвхөн өөрчлөгдсөн хэсгүүдийг нь update хийдэг болгуулаарай»; contract
    _shared/delta-update-contract-2026-10-26.md). Studio, CGA (AutoCAD, net48), CGM, PFA and
    PFR (Revit, net48/net8) all call this - none keeps its own copy of a rule.
  -->

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ErkS.Updates</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="9.0.1" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ErkS.Updates.Tests" />
  </ItemGroup>

</Project>
