<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.182</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.79</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.80-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.80</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
