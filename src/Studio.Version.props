<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.188</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.85</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.86-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.86</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
