<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.39</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.39</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.40-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.40</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
