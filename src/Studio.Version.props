<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.49</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.49</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.50-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.50</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
