<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.23</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.23</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.24-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.24</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
