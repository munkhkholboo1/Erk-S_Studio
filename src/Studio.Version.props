<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.184</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.81</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.82-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.82</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
