<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.43</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.43</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.44-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.44</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
