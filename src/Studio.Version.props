<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.37</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.37</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.38-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.38</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
