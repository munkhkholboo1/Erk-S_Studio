<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.177</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.74</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.75-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.75</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
