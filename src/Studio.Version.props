<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.120</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.72</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.73-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.73</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
