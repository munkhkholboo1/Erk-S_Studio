<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.191</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.88</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.89-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.89</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
