<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.29</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.29</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.30-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.30</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
