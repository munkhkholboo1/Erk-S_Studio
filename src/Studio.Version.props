<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.67</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.67</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.68-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.68</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
