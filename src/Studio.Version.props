<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.27</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.27</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.28-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.28</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
