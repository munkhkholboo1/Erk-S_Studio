<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.58</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.58</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.59-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.59</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
