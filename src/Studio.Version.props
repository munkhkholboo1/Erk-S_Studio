<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.52</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.52</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.53-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.53</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
