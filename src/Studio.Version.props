<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.176</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.73</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.74-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.74</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
