<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.21</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.21</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.22-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.22</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
