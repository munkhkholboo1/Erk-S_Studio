<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.179</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.76</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.77-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.77</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
