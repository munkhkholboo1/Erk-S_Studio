<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.71</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.71</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.72-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.72</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
