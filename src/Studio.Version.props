<Project>
  <PropertyGroup>
    <!--
      Update these four values together when a Demo release is published.
      DevelopmentVersion is always the next Studio version after PublishedVersion.
    -->
    <StudioPublishedVersion>0.001.41</StudioPublishedVersion>
    <StudioPublishedAssemblyVersion>0.0.1.41</StudioPublishedAssemblyVersion>
    <StudioDevelopmentVersion>0.001.42-dev</StudioDevelopmentVersion>
    <StudioDevelopmentAssemblyVersion>0.0.1.42</StudioDevelopmentAssemblyVersion>
  </PropertyGroup>
</Project>
